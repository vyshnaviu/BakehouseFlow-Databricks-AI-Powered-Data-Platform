    {
      "name": "a2187fc5",
      "displayName": "fact_sales",
      "config": {
        "version": "1.1",
        "source": "bakehouse_project.gld.fact_sales",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "total_sales",
            "expr": "SUM(total_price)",
            "displayName": "Total Sales",
            "format": {
              "type": "number",
              "abbreviation": "compact"
            }
          },
          {
            "name": "total_units",
            "expr": "SUM(quantity)",
            "displayName": "Total Units"
          },
          {
            "name": "transaction_count",
            "expr": "COUNT(DISTINCT transaction_id)",
            "displayName": "Transactions"
          },
          {
            "name": "avg_order_value",
            "expr": "MEASURE(`total_sales`) / MEASURE(`transaction_count`)",
            "displayName": "Average Order Value",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    }
  ],
  "relationshipGraphs": [
    {
      "sources": [
        {
