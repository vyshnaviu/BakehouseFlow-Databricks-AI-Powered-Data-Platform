        {
          "name": "fact_sales",
          "datasetName": "a2187fc5"
        }
      ],
      "relationships": [
        {
          "name": "relationship_0",
          "from": "fact_sales",
          "to": "dim_franchise",
          "on": "`fact_sales`.`franchise_key` = `dim_franchise`.`franchise_key`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "relationship_1",
          "from": "fact_sales",
          "to": "dim_customer",
          "on": "`fact_sales`.`customer_key` = `dim_customer`.`customer_key`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "relationship_2",
          "from": "dim_franchise",
          "to": "dim_supplier",
          "on": "`dim_franchise`.`supplier_key` = `dim_supplier`.`supplier_key`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        }
      ]
    }
